<?xml version="1.0" encoding="utf-8"?>
<!-- V3.5: Charging animation: fullscreen liquid fill + center battery percentage -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/charging_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">
    
    <!-- Fullscreen liquid fill (with gravity sensing and waves) -->
    <com.tgwgroup.MiRearScreenSwitcher.LightningShapeView
        android:id="@+id/full_screen_liquid"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    
    <!-- Battery percentage centered in the safe area -->
    <TextView
        android:id="@+id/battery_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="100%"
        android:textSize="60sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="6"
        android:shadowRadius="12"
        android:letterSpacing="0.05" />
</FrameLayout>
