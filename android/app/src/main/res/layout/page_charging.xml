<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp">

        <!-- Empty state -->
        <TextView
            android:id="@+id/page_charge_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Not charging"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:id="@+id/page_charge_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Plug in charger"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:gravity="center"/>

        <!-- Filled state -->
        <FrameLayout
            android:id="@+id/page_charge_liquid"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:visibility="gone">

            <com.tgwgroup.MiRearScreenSwitcher.LightningShapeView
                android:id="@+id/page_charge_liquid_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <TextView
                android:id="@+id/page_charge_pct"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
